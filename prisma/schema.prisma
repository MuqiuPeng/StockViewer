generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// NextAuth.js Required Models
// ============================================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  status        UserStatus @default(PENDING)
  isAdmin       Boolean    @default(false)
  accounts      Account[]
  sessions      Session[]

  // Status review info
  statusReviewedBy   String?
  statusReviewedAt   DateTime?
  statusReviewNote   String?    @db.Text
  statusReviewer     User?      @relation("UserStatusReviewer", fields: [statusReviewedBy], references: [id], onDelete: SetNull)
  reviewedUsers      User[]     @relation("UserStatusReviewer")

  // User's collections (what they're using)
  userStocks       UserStock[]
  userIndicators   UserIndicator[]
  userStrategies   UserStrategy[]
  userGroups       UserStockGroup[]
  userViewSettings UserViewSetting[]

  // User created content
  createdIndicators   Indicator[]   @relation("IndicatorCreator")
  createdStrategies   Strategy[]    @relation("StrategyCreator")
  createdGroups       StockGroup[]  @relation("GroupCreator")
  createdViewSettings ViewSetting[] @relation("ViewSettingCreator")

  // Other user data
  backtestHistory BacktestHistoryEntry[]
  settings        UserSettings?

  // Tickets
  submittedTickets Ticket[] @relation("TicketSubmitter")
  reviewedTickets  Ticket[] @relation("TicketReviewer")

  // Share posts
  sharePosts SharePost[]

  // User Groups
  ownedGroups       UserGroup[]           @relation("GroupOwner")
  groupMemberships  UserGroupMember[]
  groupInvitations  UserGroupInvitation[]
  groupMessages     UserGroupMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserSettings {
  id            String  @id @default(cuid())
  userId        String  @unique
  setupComplete Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================================
// SHARED STOCK DATA
// ============================================================================

/// Stock master data - shared across all users
model Stock {
  id         String  @id @default(cuid())
  symbol     String
  name       String
  dataSource String
  category   String?
  exchange   String?

  firstDate  DateTime?
  lastDate   DateTime?
  lastUpdate DateTime?
  rowCount   Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  priceData       StockPrice[]
  userStocks      UserStock[]
  stockIndicators StockIndicator[]
  sharePosts      SharePost[]

  @@unique([symbol, dataSource])
  @@index([symbol])
  @@index([dataSource])
  @@index([category])
}

/// Stock price time-series data
model StockPrice {
  id      String   @id @default(cuid())
  stockId String
  date    DateTime @db.Date

  open   Decimal @db.Decimal(18, 4)
  high   Decimal @db.Decimal(18, 4)
  low    Decimal @db.Decimal(18, 4)
  close  Decimal @db.Decimal(18, 4)
  volume BigInt  @default(0)

  turnover     Decimal? @db.Decimal(24, 2)
  amplitude    Decimal? @db.Decimal(12, 4)
  changePct    Decimal? @db.Decimal(12, 4)
  changeAmount Decimal? @db.Decimal(18, 4)
  turnoverRate Decimal? @db.Decimal(12, 4)

  stock           Stock            @relation(fields: [stockId], references: [id], onDelete: Cascade)
  indicatorValues IndicatorValue[]

  @@unique([stockId, date])
  @@index([stockId, date])
  @@index([date])
}

/// User's stock collection
model UserStock {
  id      String   @id @default(cuid())
  userId  String
  stockId String
  addedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  stock Stock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@unique([userId, stockId])
  @@index([userId])
  @@index([stockId])
}

// ============================================================================
// SHARED INDICATORS
// ============================================================================

/// Indicator definitions
model Indicator {
  id        String @id @default(cuid())
  createdBy String

  name         String
  description  String @db.Text
  pythonCode   String @db.Text
  outputColumn String

  // Versioning for cache invalidation
  version  Int    @default(1) // Increments on code change
  codeHash String @default("") // SHA256 of pythonCode for change detection

  dependencies      String[]
  dependencyColumns String[]

  isGroup         Boolean  @default(false)
  groupName       String?
  expectedOutputs String[]

  externalDatasets Json?
  category         String?
  tags             String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator         User             @relation("IndicatorCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  userIndicators  UserIndicator[]
  indicatorValues IndicatorValue[]
  stockIndicators StockIndicator[]
  sharePosts      SharePost[]
  groupMessages   UserGroupMessage[]

  @@unique([name]) // Globally unique names for shared indicators
  @@index([createdBy])
  @@index([category])
}

/// User's indicator collection (subscriptions)
model UserIndicator {
  id          String   @id @default(cuid())
  userId      String
  indicatorId String
  displayName String?  // Custom display name for this subscription
  addedAt     DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  indicator Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@unique([userId, indicatorId])
  @@index([userId])
  @@index([indicatorId])
}

/// Indicator computed values - linked to specific StockPrice records
model IndicatorValue {
  id           String @id @default(cuid())
  indicatorId  String
  stockPriceId String
  version      Int // Indicator version when computed

  value       Decimal? @db.Decimal(18, 6)
  groupValues Json?

  computedAt DateTime @default(now())

  indicator  Indicator  @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  stockPrice StockPrice @relation(fields: [stockPriceId], references: [id], onDelete: Cascade)

  @@unique([indicatorId, stockPriceId, version])
  @@index([indicatorId, version])
  @@index([stockPriceId])
}

/// Tracks which indicators have been computed for which stocks
model StockIndicator {
  id          String   @id @default(cuid())
  stockId     String
  indicatorId String
  version     Int // Indicator version that was computed
  rowCount    Int      @default(0) // Number of values computed
  computedAt  DateTime @default(now())

  stock     Stock     @relation(fields: [stockId], references: [id], onDelete: Cascade)
  indicator Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@unique([stockId, indicatorId])
  @@index([stockId])
  @@index([indicatorId])
}

// ============================================================================
// SHARED STRATEGIES
// ============================================================================

/// Trading strategies
model Strategy {
  id        String @id @default(cuid())
  createdBy String

  name             String
  description      String   @db.Text
  pythonCode       String   @db.Text
  strategyType     String   @default("single")
  constraints      Json?
  parameters       Json?
  externalDatasets Json?
  dependencies     String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator         User                   @relation("StrategyCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  userStrategies  UserStrategy[]
  backtestHistory BacktestHistoryEntry[]
  sharePosts      SharePost[]
  groupMessages   UserGroupMessage[]

  @@unique([name]) // Globally unique names for shared strategies
  @@index([createdBy])
}

/// User's strategy collection (subscriptions)
model UserStrategy {
  id          String   @id @default(cuid())
  userId      String
  strategyId  String
  displayName String?  // Custom display name for this subscription
  addedAt     DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@unique([userId, strategyId])
  @@index([userId])
  @@index([strategyId])
}

/// Backtest history - always user-specific
model BacktestHistoryEntry {
  id           String @id @default(cuid())
  userId       String
  strategyId   String
  strategyName String
  strategyType String

  target     Json
  parameters Json
  result     Json

  starred Boolean  @default(false)
  notes   String?  @db.Text
  tags    String[]

  totalReturn    Float
  totalReturnPct Float
  sharpeRatio    Float
  tradeCount     Int
  duration       Int

  createdAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, starred])
  @@index([strategyId])
}

// ============================================================================
// SHARED STOCK GROUPS
// ============================================================================

/// Stock groups (watchlists, portfolios)
model StockGroup {
  id        String @id @default(cuid())
  createdBy String

  name           String
  description    String?  @db.Text
  stockIds       String[]
  isDataSource   Boolean  @default(false)
  dataSourceName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator       User               @relation("GroupCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  userGroups    UserStockGroup[]
  groupMessages UserGroupMessage[]

  @@unique([name]) // Globally unique names for shared groups
  @@index([createdBy])
}

/// User's group collection (subscriptions)
model UserStockGroup {
  id          String   @id @default(cuid())
  userId      String
  groupId     String
  displayName String?  // Custom display name for this subscription
  addedAt     DateTime @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  group StockGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([userId])
  @@index([groupId])
}

// ============================================================================
// SHARED VIEW SETTINGS
// ============================================================================

/// View settings (chart configs) - can be shared as presets
model ViewSetting {
  id        String @id @default(cuid())
  createdBy String

  name               String
  enabledIndicators1 String[]
  enabledIndicators2 String[]
  constantLines1     Json
  constantLines2     Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator          User               @relation("ViewSettingCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  userViewSettings UserViewSetting[]
  groupMessages    UserGroupMessage[]

  @@unique([name]) // Globally unique names for shared presets
  @@index([createdBy])
}

/// User's view setting collection (subscriptions)
model UserViewSetting {
  id            String   @id @default(cuid())
  userId        String
  viewSettingId String
  displayName   String?  // Custom display name for this subscription
  addedAt       DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewSetting ViewSetting @relation(fields: [viewSettingId], references: [id], onDelete: Cascade)

  @@unique([userId, viewSettingId])
  @@index([userId])
  @@index([viewSettingId])
}

// ============================================================================
// DATA IMPORT JOB TRACKING
// ============================================================================

enum ImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model DataImportJob {
  id         String          @id @default(cuid())
  symbol     String
  dataSource String
  status     ImportJobStatus @default(PENDING)

  progress Int     @default(0)
  message  String?

  errorMessage String?
  retryCount   Int     @default(0)

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([symbol, dataSource])
}

// ============================================================================
// TICKET SYSTEM
// ============================================================================

enum UserStatus {
  PENDING  // Awaiting admin approval
  APPROVED // Approved, can access the app
  REJECTED // Rejected, cannot access
}

enum TicketType {
  FULL_REFRESH   // Request full refresh of stock data
  CUSTOM_DATA    // Request to upload custom data
  DELETE_DATASET // Request to delete a custom dataset
}

enum TicketStatus {
  PENDING  // Awaiting review
  APPROVED // Approved (processed or processing)
  REJECTED // Rejected
}

/// Tickets for admin approval
model Ticket {
  id     String       @id @default(cuid())
  userId String
  type   TicketType
  status TicketStatus @default(PENDING)

  // Request details (JSON: { stockId, symbol, dataSource, reason })
  // For CUSTOM_DATA: { symbol, name, description }
  payload Json

  // Review info
  reviewedBy String?
  reviewNote String?   @db.Text
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User         @relation("TicketSubmitter", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User?        @relation("TicketReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  csvData  CsvDataBlob? // CSV data for CUSTOM_DATA tickets

  @@index([userId])
  @@index([status])
  @@index([type, status])
  @@index([createdAt])
}

/// Temporary storage for CSV data during ticket approval process
model CsvDataBlob {
  id       String @id @default(cuid())
  ticketId String @unique

  filename String
  rowCount Int
  fileSize Int // Size in bytes

  // Parsed CSV data stored as JSON array
  data          Json  @db.JsonB
  columnMapping Json? // Column name mapping (original -> normalized)

  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

// ============================================================================
// SHARE POSTS
// ============================================================================

/// Share posts - users can share their datasets, indicators, or strategies
model SharePost {
  id      String  @id @default(cuid())
  userId  String
  title   String
  content String? @db.Text // Optional post content

  // What's being shared (only one should be set)
  stockId     String?
  indicatorId String?
  strategyId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  stock     Stock?     @relation(fields: [stockId], references: [id], onDelete: SetNull)
  indicator Indicator? @relation(fields: [indicatorId], references: [id], onDelete: SetNull)
  strategy  Strategy?  @relation(fields: [strategyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

// ============================================================================
// USER GROUPS
// ============================================================================

/// User groups for team collaboration
model UserGroup {
  id          String @id @default(cuid())
  name        String
  description String? @db.Text
  ownerId     String

  owner       User                  @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     UserGroupMember[]
  invitations UserGroupInvitation[]
  messages    UserGroupMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

/// User group membership
model UserGroupMember {
  id       String @id @default(cuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

/// User group invitations
model UserGroupInvitation {
  id        String @id @default(cuid())
  groupId   String
  userId    String
  status    String @default("pending") // pending | accepted | rejected
  createdAt DateTime @default(now())

  group UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@index([status])
}

/// User group messages (chat + resource sharing)
model UserGroupMessage {
  id      String  @id @default(cuid())
  groupId String
  userId  String
  content String? @db.Text

  // Shared resources (only one can be set)
  indicatorId   String?
  strategyId    String?
  stockGroupId  String?
  viewSettingId String?

  group       UserGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  indicator   Indicator?   @relation(fields: [indicatorId], references: [id], onDelete: SetNull)
  strategy    Strategy?    @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  stockGroup  StockGroup?  @relation(fields: [stockGroupId], references: [id], onDelete: SetNull)
  viewSetting ViewSetting? @relation(fields: [viewSettingId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([groupId])
  @@index([userId])
  @@index([groupId, createdAt])
}
