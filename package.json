{
  "name": "stockviewer",
  "version": "1.0.0",
  "private": true,
  "description": "Workspace root. The app is apps/web; see README.md for the layout.",
  "workspaces": [
    "apps/web",
    "packages/db",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm run dev -w @stockviewer/web",
    "build": "npm run build -w @stockviewer/web",
    "start": "npm run start -w @stockviewer/web",
    "lint": "npm run lint -w @stockviewer/web",
    "typecheck": "tsc --noEmit && npm run typecheck -w @stockviewer/web",
    "db:generate": "prisma generate --config packages/db/prisma.config.ts",
    "db:migrate": "prisma migrate dev --config packages/db/prisma.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config packages/db/prisma.config.ts",
    "db:status": "prisma migrate status --config packages/db/prisma.config.ts"
  },
  "devDependencies": {
    "@prisma/client": "^6.19.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.10.0",
    "@types/papaparse": "^5.3.14",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "papaparse": "^5.4.1",
    "pg": "^8.17.1",
    "prisma": "^6.19.2",
    "typescript": "^5.3.3",
    "tsx": "^4.19.2"
  }
}
