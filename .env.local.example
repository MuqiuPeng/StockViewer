# Stock Viewer — environment configuration
#
# Copy to .env.local and fill in. Both the Next.js app and the Python data
# service read .env and .env.local from the repository root, so a single file
# configures both; which of the two you use is a matter of taste.
#
# Nothing here has a working default. Every secret below must be generated —
# the commands are given inline — because a shipped default secret is not a
# default, it is a published one.


# =============================================================================
# Required: database
# =============================================================================

# Postgres connection string. The repo ships a project-local cluster under
# .pgdata, which is gitignored and disposable; see SETUP.md to initialise it.
DATABASE_URL=postgresql://USER@localhost:5432/stockviewer

# 'database' stores strategies, indicators and datasets in Postgres and turns
# on authentication. Anything else selects the file-based mode.
NEXT_PUBLIC_STORAGE_MODE=database


# =============================================================================
# Required: secrets
#
# Generate each one. Do not copy these values between installations, and do
# not reuse one variable's value for another.
# =============================================================================

# Signs session tokens. Changing it logs everyone out, which is all it costs.
#   openssl rand -base64 32
AUTH_SECRET=

AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Encrypts provider API keys at rest in the ProviderCredential table.
#
# This is the one secret with no cheap recovery: lose it and every stored
# credential becomes unreadable ciphertext, and each provider key has to be
# fetched from its dashboard and entered again. Back it up somewhere other
# than the machine that uses it.
#   openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# Presented by the web app to the data service on every call, and required by
# it. Without this the data service refuses to serve rather than serving
# unprotected.
#   openssl rand -hex 32
DATA_SERVICE_TOKEN=

# Presented by the data service when it forwards its logs to the web app.
#   openssl rand -hex 32
LOG_INGEST_SECRET=

# Required by the scheduled dataset-update endpoint. Unset means that endpoint
# rejects every caller.
#   openssl rand -hex 32
CRON_SECRET=


# =============================================================================
# Data service
# =============================================================================

# Where the web app reaches the data service. Deliberately not NEXT_PUBLIC_:
# the token above travels with these requests and must never reach a browser.
DATA_SERVICE_URL=http://localhost:8000
DATA_SERVICE_TIMEOUT_MS=60000
DATA_SERVICE_RETRIES=2

# Where the data service listens. Loopback unless you mean otherwise — binding
# elsewhere puts every provider credential behind one shared token.
BIND_HOST=127.0.0.1
BIND_PORT=8000

# Default provider when a request names none. Routing chains in
# data-service/config/providers.toml decide the rest.
DATA_PROVIDER=eastmoney


# =============================================================================
# Python execution
# =============================================================================

# Leave as python3 to use the repo's own virtualenv when one is present.
PYTHON_EXECUTABLE=python3
PYTHON_TIMEOUT_MS=300000


# =============================================================================
# Provider credentials
# =============================================================================
#
# API keys are not configured here. They live encrypted in the database and
# are managed from the admin UI, so that quotas, validity windows and rotation
# are recorded alongside them rather than being remembered by whoever edited
# this file. See docs/DATA_SOURCES.md.
#
# The one exception is Alpaca's endpoint, which selects paper or live trading
# data and is not a secret.
ALPACA_ENDPOINT=https://paper-api.alpaca.markets/v2
