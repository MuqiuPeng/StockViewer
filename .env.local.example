# Stock Viewer Environment Configuration
# Copy this file to .env.local and customize as needed

# =============================================================================
# Data Service Configuration
# =============================================================================

# Data Service URL (stock data API powered by akshare)
# Default: http://localhost:8000
# Start with: docker compose up data-service
DATA_SERVICE_URL=http://localhost:8000

# Data Service timeout in milliseconds
# Default: 60000 (1 minute)
DATA_SERVICE_TIMEOUT_MS=60000

# Data Service retry count
# Default: 2
DATA_SERVICE_RETRIES=2

# =============================================================================
# Python Execution Configuration
# =============================================================================

# Python executable path (optional)
# If not set, will use 'python3' from PATH
# Example: /usr/local/bin/python3 or path/to/venv/bin/python
PYTHON_EXECUTABLE=python3

# Python script timeout in milliseconds
# Default: 300000 (5 minutes)
# Increase for large datasets or complex indicators
PYTHON_TIMEOUT_MS=300000

# =============================================================================
# Data Storage Configuration
# =============================================================================

# Storage mode: 'local', 'online', or 'database'
# - local: Uses file-based storage (Node.js fs) - for local/Docker deployment
# - online: Uses browser-based storage (IndexedDB) - for online demo
# - database: Uses PostgreSQL with auth - for multi-user production deployment
# Default: 'local' on server, 'online' in browser
NEXT_PUBLIC_STORAGE_MODE=local

# =============================================================================
# Authentication (only required when STORAGE_MODE=database)
# =============================================================================

# NextAuth secret - generate with: openssl rand -base64 32
# Required for database mode
# AUTH_SECRET=your-secret-key-here

# NextAuth URL - must match the address people actually open in the browser.
# On a local network that is the machine's LAN address, not localhost, or
# sign-in will redirect to the wrong host.
# AUTH_URL=http://localhost:3000

# Sign-in is email + password against local accounts; there is no external
# identity provider. Create the first admin with:
#   npx tsx scripts/create-admin.ts <email> <password> [name]
# Everyone else registers at /auth/register and waits for approval in /admin.

# =============================================================================
# Database (only required when STORAGE_MODE=database)
# =============================================================================

# PostgreSQL connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# DATABASE_URL=postgresql://stockviewer:password@localhost:5432/stockviewer

# CSV data directory - path to your local stock CSV files
# This is a LOCAL folder where you store your CSV data files
# All users of this installation share this folder (not per-user storage)
# Default: {project_root}/data/csv
# CSV_DATA_PATH=/path/to/your/stock-data

# Maximum CSV file size in MB
# Default: 50
# Used to prevent memory issues with very large datasets
MAX_CSV_SIZE_MB=50

# Indicators storage file
# Default: {project_root}/data/indicators/indicators.json
# INDICATORS_FILE=/custom/path/to/indicators.json

# =============================================================================
# Performance & Caching
# =============================================================================

# Enable dataset caching (future feature)
# Default: false
ENABLE_DATASET_CACHE=false

# Dataset cache TTL in seconds
# Default: 300 (5 minutes)
DATASET_CACHE_TTL=300

# =============================================================================
# Security & Rate Limiting
# =============================================================================

# Cron job secret - used to authenticate scheduled tasks
# Generate with: openssl rand -base64 32
# This protects the /api/cron/* endpoints from unauthorized access
# CRON_SECRET=your-cron-secret-here

# Enable request rate limiting (future feature)
# Default: false
ENABLE_RATE_LIMITING=false

# Maximum API requests per minute per IP
# Default: 60
RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# Development & Debugging
# =============================================================================

# Enable debug logging
# Default: false
DEBUG=false

# Log level: error, warn, info, debug
# Default: info
LOG_LEVEL=info

# Log directory
# Default: {project_root}/logs
# LOG_DIR=/custom/path/to/logs
