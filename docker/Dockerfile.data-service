# Stock Data Service Dockerfile
# A REST API service for fetching stock market data

FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN useradd --create-home --shell /bin/bash dataservice

WORKDIR /app

# Copy and install Python dependencies
COPY data-service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY data-service/app ./app

# Set ownership
RUN chown -R dataservice:dataservice /app

# Switch to non-root user
USER dataservice

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/api/v1/health || exit 1

# Run the application
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
